[mgr]
show_hidden = true

[opener]
edit = [
  { run = 'nvim "$@"', desc = "Editar con Neovim", block = true },
  { run = 'code "$@"', desc = "Editar con VisualStudio Code", block = true },
]
display = [
  { run = 'xdg-open "$@"', desc = "Abrir", orphan = true },
]
pdf = [
  { run = 'okular "$@"', desc = "Okular", orphan = true },
  { run = 'xournalpp "$@"', desc = "Xournal++", orphan = true },
  { run = 'rnote "$@"', desc = "Rnote", orphan = true },
]
xournal = [
  { run = 'xournalpp "$@"', desc = "Xournal++", orphan = true },
]
rnote = [
  { run = 'rnote "$@"', desc = "Rnote", orphan = true },
]
markdown = [
  { run = 'typora "$@"', desc = "Typora", orphan = true },
]
latex = [
  { run = 'nvim "$@"',      desc = "Editar con Neovim", block = true },
]

[open]
prepend_rules = [
  { url = "**/*.xopp",   use = "xournal" },
  { url = "**/*.rnote", use = "rnote" },
  { url = "**/*.md",   use = "markdown" },
  { url = "**/*.tex",  use = "edit" },
  { url = "**/*.asm",  use = "edit" },
  { url = "**/*.s",    use = "edit" },
  { url = "**/*.S",    use = "edit" },
  { mime = "image/*",   use = "display" },
]

rules = [
  { mime = "application/x-xopp",        use = "xournal" },
  { mime = "text/*",                    use = "edit" },
  { mime = "application/json",          use = "edit" },
  { mime = "application/toml",          use = "edit" },
  { mime = "application/xml",           use = "edit" },
  { mime = "application/javascript",    use = "edit" },
  { mime = "application/x-shellscript", use = "edit" },
  { mime = "inode/x-empty",             use = "edit" },
  { mime = "application/pdf",           use = "pdf" },
]
