[Unit]
Description=Montar Google Drive en ~/GoogleDrive (rclone mount)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 10G \
  --vfs-cache-max-age 72h \
  --dir-cache-time 1h \
  --poll-interval 1m \
  --drive-export-formats docx,xlsx,pptx,svg \
  --umask 022 \
  --log-level INFO \
  --log-file %h/.local/state/gdrive-mount.log
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
