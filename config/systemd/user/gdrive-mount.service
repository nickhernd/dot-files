[Unit]
Description=Montar Google Drive en ~/GoogleDrive (rclone mount)
# Se vuelve a montar solo si se desmonta por accidente (expulsar, fusermount -u...).
# Para desmontarlo a propósito: systemctl --user stop gdrive-mount
StartLimitIntervalSec=0

[Service]
Type=notify
# Esperar a que haya red y DNS (hasta 5 min) antes de montar
ExecStartPre=/bin/sh -c 'for i in $(seq 150); do getent hosts www.googleapis.com >/dev/null && exit 0; sleep 2; done; exit 1'
# Limpiar un montaje "colgado" que haya quedado de antes
ExecStartPre=-/usr/bin/fusermount3 -uz %h/GoogleDrive
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 10G \
  --vfs-cache-max-age 72h \
  --dir-cache-time 1h \
  --poll-interval 1m \
  --drive-export-formats docx,xlsx,pptx,svg \
  --umask 022 \
  --log-level INFO \
  --log-file %h/.local/state/gdrive-mount.log
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
# Volver a montar siempre que se caiga o se desmonte (salvo stop manual)
Restart=always
RestartSec=5
TimeoutStartSec=6min

[Install]
WantedBy=default.target
