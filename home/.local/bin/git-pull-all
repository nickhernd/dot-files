#!/bin/bash

# git-pull-all: En cada repo del directorio actual hace git pull si hay commits remotos nuevos

RESET=$'\e[0m'
BOLD=$'\e[1m'
GREEN=$'\e[1;32m'
RED=$'\e[1;31m'
YELLOW=$'\e[1;33m'
CYAN=$'\e[0;36m'
GRAY=$'\e[0;90m'

echo -e "${BOLD}Pull automático en repositorios de $(pwd)...${RESET}\n"

find . -maxdepth 4 -name ".git" -type d -prune | while read -r gitdir; do
    repo_dir=$(dirname "$gitdir")
    display_name=${repo_dir#./}

    cd "$repo_dir" || continue

    timeout 3 git fetch --quiet 2>/dev/null

    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)

    if [ -z "$upstream" ]; then
        printf "${GRAY}%-40s${RESET} sin remoto configurado, saltando\n" "$display_name"
        cd - > /dev/null
        continue
    fi

    counts=$(git rev-list --left-right --count HEAD...$upstream 2>/dev/null)
    behind=$(echo "$counts" | cut -f2)

    if [ -z "$behind" ] || [ "$behind" -eq 0 ]; then
        printf "${GREEN}%-40s${RESET} ya sincronizado\n" "$display_name"
        cd - > /dev/null
        continue
    fi

    printf "${BOLD}%-40s${RESET} ${CYAN}→ $behind commits nuevos, haciendo pull...${RESET}\n" "$display_name"

    if git pull 2>&1; then
        printf "${GREEN}%-40s${RESET} pull OK\n" "$display_name"
    else
        printf "${RED}%-40s${RESET} pull FALLIDO\n" "$display_name"
    fi

    cd - > /dev/null
done
