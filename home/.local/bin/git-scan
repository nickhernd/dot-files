#!/bin/bash

# git-scan: Escanea directorios en busca de repositorios Git y muestra su estado real.

# Colores
RESET=$'\e[0m'
BOLD=$'\e[1m'
GREEN=$'\e[1;32m'
RED=$'\e[1;31m'
YELLOW=$'\e[1;33m'
CYAN=$'\e[0;36m'
GRAY=$'\e[0;90m'

echo -e "${BOLD}Escaneando y actualizando repositorios Git en $(pwd)...${RESET}"
echo -e "${GRAY}(Esto puede tardar unos segundos si tienes muchos remotos)${RESET}\n"

# Buscar directorios .git hasta profundidad 4
find . -maxdepth 4 -name ".git" -type d -prune | while read -r gitdir; do
    repo_dir=$(dirname "$gitdir")
    display_name=${repo_dir#./}
    
    cd "$repo_dir" || continue
    
    # Intentar un fetch rápido para saber el estado real del remoto
    # Usamos el comando timeout del sistema para no quedarnos colgados
    if git remote | grep -q '.*'; then
        timeout 5s git fetch --quiet 2>/dev/null
    fi
    
    # Obtener nombre de la rama
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    
    # Verificar cambios locales (status)
    status=$(git status --porcelain)
    
    # Verificar sincronización con el remoto (Ahead/Behind)
    # Intentamos obtener el upstream, si no existe no comparamos
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
    ahead_behind=""
    needs_attention=false
    
    if [ -n "$upstream" ]; then
        counts=$(git rev-list --left-right --count HEAD...$upstream 2>/dev/null)
        ahead=$(echo "$counts" | cut -f1)
        behind=$(echo "$counts" | cut -f2)
        
        if [ -n "$behind" ] && [ "$behind" -gt 0 ]; then
            ahead_behind+=" ${RED}[Behind $behind -> Pull necesario]${RESET}"
            needs_attention=true
        fi
        if [ -n "$ahead" ] && [ "$ahead" -gt 0 ]; then
            ahead_behind+=" ${YELLOW}[Ahead $ahead -> Push necesario]${RESET}"
            needs_attention=true
        fi
    fi
    
    # Si hay archivos modificados, también requiere atención
    [ -n "$status" ] && needs_attention=true

    # Formatear la salida
    if [ "$needs_attention" = true ]; then
        printf "${BOLD}%-40s${RESET} ${CYAN}(%s)${RESET}%s\n" "$display_name" "$branch" "$ahead_behind"
        if [ -n "$status" ]; then
            # Mostrar los primeros 5 archivos modificados
            echo "$status" | sed 's/^/  /' | head -n 5
            [ $(echo "$status" | wc -l) -gt 5 ] && echo "  ..."
        fi
    else
        # Todo correcto y sincronizado
        printf "${GREEN}%-40s${RESET} ${CYAN}(%s)${RESET} ${GRAY}[Sincronizado]${RESET}\n" "$display_name" "$branch"
    fi
    
    cd - > /dev/null
done
