#!/bin/bash

# git-push-all: En cada repo del directorio actual hace git add . + commit + push

RESET=$'\e[0m'
BOLD=$'\e[1m'
GREEN=$'\e[1;32m'
RED=$'\e[1;31m'
YELLOW=$'\e[1;33m'
CYAN=$'\e[0;36m'
GRAY=$'\e[0;90m'

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

echo -e "${BOLD}Push automático en repositorios de $(pwd)...${RESET}"
echo -e "${GRAY}Timestamp: $TIMESTAMP${RESET}\n"

find . -maxdepth 4 -name ".git" -type d -prune | while read -r gitdir; do
    repo_dir=$(dirname "$gitdir")
    display_name=${repo_dir#./}

    cd "$repo_dir" || continue

    status=$(git status --porcelain)

    if [ -z "$status" ]; then
        printf "${GRAY}%-40s${RESET} sin cambios, saltando\n" "$display_name"
        cd - > /dev/null
        continue
    fi

    printf "${BOLD}%-40s${RESET} ${CYAN}→ añadiendo y commiteando...${RESET}\n" "$display_name"

    git add .

    if git commit -m "push $TIMESTAMP"; then
        if git push 2>&1; then
            printf "${GREEN}%-40s${RESET} push OK\n" "$display_name"
        else
            printf "${RED}%-40s${RESET} push FALLIDO\n" "$display_name"
        fi
    else
        printf "${RED}%-40s${RESET} commit falló\n" "$display_name"
    fi

    cd - > /dev/null
done
