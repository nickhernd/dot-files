#!/usr/bin/env python3
"""Últimos papers de arXiv en JSON para el widget. Uso: arxiv-top [seguridad|sistemas|mates|todo] [N]"""
import json, sys, urllib.request, urllib.parse, xml.etree.ElementTree as ET

CATS = {
    "seguridad": ["cs.CR"],
    "sistemas": ["cs.OS", "cs.AR", "cs.PL"],
    "mates": ["math.NT", "math.CO", "math.PR", "math.LO"],
    "todo": ["cs.CR", "cs.OS", "cs.AR", "math.NT", "math.CO"],
}
sel = sys.argv[1] if len(sys.argv) > 1 else "todo"
n = int(sys.argv[2]) if len(sys.argv) > 2 else 5
q = " OR ".join(f"cat:{c}" for c in CATS.get(sel, CATS["todo"]))
url = "https://export.arxiv.org/api/query?" + urllib.parse.urlencode(
    {"search_query": q, "sortBy": "submittedDate", "sortOrder": "descending", "max_results": n})
ns = {"a": "http://www.w3.org/2005/Atom", "arxiv": "http://arxiv.org/schemas/atom"}
try:
    req = urllib.request.Request(url, headers={"User-Agent": "desktop-widget/1.0"})
    root = ET.fromstring(urllib.request.urlopen(req, timeout=15).read())
except Exception:
    print("[]"); sys.exit()
out = []
for e in root.findall("a:entry", ns):
    authors = [a.findtext("a:name", "", ns) for a in e.findall("a:author", ns)]
    first = authors[0].split()[-1] if authors else ""
    prim = e.find("arxiv:primary_category", ns)
    link = e.findtext("a:id", "", ns).replace("http://", "https://")
    out.append({
        "title": " ".join(e.findtext("a:title", "", ns).split()),
        "authors": first + (" et al." if len(authors) > 1 else ""),
        "cat": prim.get("term") if prim is not None else "",
        "date": e.findtext("a:published", "", ns)[:10],
        "url": link,
    })
print(json.dumps(out, ensure_ascii=False))
