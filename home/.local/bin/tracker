def load():
    try:
        d = json.load(open(PATH))
    except Exception:
        d = {"version": 1}
    d.setdefault("habits", DEFAULT); d.setdefault("streaks", {}); d.setdefault("log", {}); d.setdefault("books", [])
    ids = [h["id"] for h in d["habits"]]
    for i, h in enumerate(DEFAULT):
        if h["id"] in ids:
            continue
        prev = next((x["id"] for x in reversed(DEFAULT[:i]) if x["id"] in [y["id"] for y in d["habits"]]), None)
        pos = [y["id"] for y in d["habits"]].index(prev) + 1 if prev else len(d["habits"])
        d["habits"].insert(pos, dict(h))
    for h in d["habits"]:
        df = next((x for x in DEFAULT if x["id"] == h["id"]), {})
        for k in ("freq", "day"):
            if k in df and k not in h:
                h[k] = df[k]
    for h in d["habits"]:
        h.setdefault("cat", next((x["cat"] for x in DEFAULT if x["id"] == h["id"]), "Otros"))
        if h["type"] == "streak" and h["id"] not in d["streaks"]:
            d["streaks"][h["id"]] = {"start": today(), "best": 0, "relapses": []}
    return d

def save(d):
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    tmp = PATH + ".tmp"
    json.dump(d, open(tmp, "w"), ensure_ascii=False, indent=1)
    os.replace(tmp, PATH)

def today(n=0):
    return (date.today() - timedelta(days=n)).isoformat()

def value(d, h, day):
    l = d["log"].get(day, {})
    return l.get("pomodoros", 0) if h.get("auto") == "pomodoros" else l.get(h["id"], 0)

def streak_days(d, hid):
    s = d["streaks"].get(hid, {"start": today()})
    return (date.today() - date.fromisoformat(s["start"])).days

def week_start(day):
    x = date.fromisoformat(day)
    return (x - timedelta(days=(x.weekday() + 2) % 7)).isoformat()   # semanas de sábado a viernes

def period(h, day):
    x = date.fromisoformat(day)
    if h.get("freq") == "weekly":
        a = date.fromisoformat(week_start(day)); return a.isoformat(), (a + timedelta(days=6)).isoformat()
    if h.get("freq") == "monthly":
        a = x.replace(day=1); b = (a.replace(year=a.year + (a.month == 12), month=a.month % 12 + 1) - timedelta(days=1))
        return a.isoformat(), b.isoformat()
    return day, day

def done(d, h, day):
    if h.get("freq") in ("weekly", "monthly"):
        a, b = period(h, day)
        return any(a <= k <= b and v.get(h["id"]) for k, v in d["log"].items())
    if h["type"] == "check": return bool(value(d, h, day))
    if h["type"] == "count": return value(d, h, day) >= h.get("goal", 1)
    if h["type"] == "streak":
        back = (date.today() - date.fromisoformat(day)).days
        return streak_days(d, h["id"]) >= back and day not in d["streaks"].get(h["id"], {}).get("relapses", [])
    return False

def bar(frac, w=20):
    n = round(max(0, min(1, frac)) * w)
    return PINK + "█" * n + DIM + "░" * (w - n) + R

def summary(d):
    print(f"\n{B}{PINK}  Hábitos · {today()}{R}")
    cats = list(dict.fromkeys(h.get("cat", "Otros") for h in d["habits"]))
    for h in [h for c in cats for h in d["habits"] if h.get("cat", "Otros") == c]:
        if h is next(x for x in d["habits"] if x.get("cat", "Otros") == h.get("cat", "Otros")):
            print(f"\n  {LAV}{h.get('cat', 'Otros').upper()}{R}")
        mark = OK + "●" if done(d, h, today()) else DIM + "○"
        if h["type"] == "streak":
            s = d["streaks"].get(h["id"], {})
            info = f"{streak_days(d, h['id'])} días  {DIM}(mejor {max(s.get('best', 0), streak_days(d, h['id']))}){R}"
        elif h["type"] == "count":
            v = value(d, h, today()); g = h.get("goal", 1)
            info = f"{bar(v / g, 12)} {v}/{g} {h.get('unit', '')}"
        elif h.get("freq") in ("weekly", "monthly"):
            per = "esta semana" if h["freq"] == "weekly" else "este mes"
            info = f"hecho {per}" if done(d, h, today()) else f"{DIM}pendiente {per}{R}"
        else:
            info = "hecho" if done(d, h, today()) else f"{DIM}pendiente{R}"
        print(f"  {mark}{R} {h['name'][:30]:<30} {info}")
    l = d["log"].get(today(), {})
    print(f"\n  {LAV}Pomodoros hoy:{R} {l.get('pomodoros', 0)}  ·  {l.get('focusMinutes', 0)} min de foco")
    if d["books"]:
        print(f"\n{B}{PINK}  Libros{R}\n")
        for i, b in enumerate(d["books"], 1):
            fin = f" {OK}✓{R}" if b.get("finished") else ""
            print(f"  {i}. {b['title'][:34]:<34} {bar(b['page'] / b['total'], 14)} {b['page']}/{b['total']}{fin}")
    print()

def week(d):
    days = [today(n) for n in range(6, -1, -1)]
    head = "".join(f"{'DLMXJVS'[(date.fromisoformat(x).weekday() + 1) % 7]:>3}" for x in days)
    print(f"\n{B}{PINK}  Últimos 7 días{R}\n  {'':<30}{head}")
    cats = list(dict.fromkeys(h.get("cat", "Otros") for h in d["habits"]))
    for h in [h for c in cats for h in d["habits"] if h.get("cat", "Otros") == c]:
        cells = "".join(f"  {OK + '●' if done(d, h, x) else DIM + '·'}{R}" for x in days)
        print(f"  {h['name'][:30]:<30}{cells}")
    print()

def ask(prompt, cast=str, default=None):
    while True:
        r = input(f"{LAV}{prompt}{R} ").strip()
        if not r and default is not None: return default
        try: return cast(r)
        except ValueError: print(f"{BAD}  valor no válido{R}")

def pick_book(d):
    if not d["books"]:
        print("No hay libros. Usa: tracker add-book"); sys.exit()
    for i, b in enumerate(d["books"], 1):
        print(f"  {i}. {b['title']}  ({b['page']}/{b['total']})")
    return ask("¿Qué libro? (número):", int) - 1

def main():
    a = sys.argv[1:]
    d = load()
    cmd = a[0] if a else "summary"
    if cmd in ("summary", "hoy"):
        summary(d)
    elif cmd == "week":
        week(d)
    elif cmd == "add-book":
        t = ask("Título del libro:")
        p = ask("Número de páginas [300]:", int, 300)
        c = ask("¿Por qué página vas? [0]:", int, 0)
        d["books"].append({"title": t, "page": min(c, p), "total": p, "updated": today()})
        save(d); print(f"{OK}✔ Añadido «{t}»{R}")
    elif cmd == "page":
        i = pick_book(d)
        b = d["books"][i]
        b["page"] = max(0, min(b["total"], ask(f"Página actual de «{b['title']}»:", int)))
        b["updated"] = today()
        if b["page"] >= b["total"]: b["finished"] = today()
        save(d); print(f"{OK}✔ Marcapáginas en la página {b['page']}{R}")
    elif cmd == "log" and len(a) == 3:
        d["log"].setdefault(today(), {})[a[1]] = int(a[2]) if a[2].isdigit() else a[2] in ("1", "si", "sí", "true")
        save(d); summary(d)
    elif cmd == "relapse" and len(a) == 2:
        s = d["streaks"].setdefault(a[1], {"start": today(), "best": 0, "relapses": []})
        s["best"] = max(s.get("best", 0), streak_days(d, a[1]))
        s.setdefault("relapses", []).append(today()); s["start"] = today()
        save(d); print(f"Racha de {a[1]} reiniciada. ¡A por otra! 💪")
    elif cmd == "start" and len(a) == 3:
        date.fromisoformat(a[2])
        d["streaks"].setdefault(a[1], {"best": 0, "relapses": []})["start"] = a[2]
        save(d); summary(d)
    elif cmd == "edit":
        if not os.path.exists(PATH): save(d)
        subprocess.call(["nvim", PATH])
    elif cmd == "excel":
        os.execvp("tracker-xlsx", ["tracker-xlsx"])
    elif cmd in ("sync", "backup", "restore"):
        os.execvp("tracker-backup", ["tracker-backup"] + (["--restore"] if cmd == "restore" else []))
    else:
        print(__doc__)
        return
    if len(a) and a[0] in ("add-book", "page") and os.environ.get("TERM"):
        input(f"{DIM}Enter para cerrar…{R}")

if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print()
