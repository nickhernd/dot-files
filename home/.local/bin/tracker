#!/usr/bin/env python3
"""tracker — hábitos, rachas y libros desde la terminal (mismos datos que el panel izquierdo).

  tracker              resumen de hoy (hábitos, rachas, libros, pomodoros)
  tracker week         tabla de los últimos 7 días
  tracker excel        regenerar el Excel (~/Documents/Tracker/habitos.xlsx y en Google Drive)
  tracker add-book     añadir un libro (título y páginas)
  tracker page         ir a una página de un libro
  tracker log ID N     fijar el valor de hoy de un hábito (p. ej. tracker log water 5)
  tracker relapse ID   reiniciar una racha (nofap, nomonster...)
  tracker start ID AAAA-MM-DD   indicar desde cuándo llevas una racha
  tracker edit         abrir el JSON en Neovim (añadir/quitar hábitos)
  tracker sync         sincronizar ahora con el otro ordenador (vía ~/dot-files, cifrado)
  tracker restore      recuperar los datos desde la copia cifrada de ~/dot-files
"""
import json, os, subprocess, sys
from datetime import date, timedelta

PATH = os.path.expanduser("~/.local/share/tracker/tracker.json")
PINK, LAV, DIM, OK, BAD, B, R = "\033[38;2;255;158;210m", "\033[38;2;200;182;255m", "\033[2m", "\033[38;2;168;230;207m", "\033[38;2;255;107;157m", "\033[1m", "\033[0m"
DEFAULT = [
    {"id": "nofap", "name": "Sin fap", "icon": "self_improvement", "type": "streak", "cat": "Salud"},
